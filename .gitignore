# Dados locais do servidor Node (banco SQLite + fotos enviadas pelo /admin).
# Nunca commitar: contém hash de senha e sessões. Ver server/paths.js.
.local/

# Estado local do `wrangler dev` (D1/R2 de teste).
.wrangler/
.dev.vars

# Segredos locais (nunca existe .env commitado neste projeto)
.env
.env.*
!.env.example

node_modules/

# Backups baixados do /admin (contêm hashes de senha) e bancos soltos.
*backup*.json
*.sqlite
*.sqlite-*

# Pacotes e entregas salvos localmente para referência (bundles, patches)
# — nunca fazem parte do site.
*.bundle

# Originais em PNG das fotos da equipe (ficam só na máquina de quem enviou;
# o site usa as versões .webp otimizadas).
public/assets/team/*nova.png
public/assets/team/*certa.png
