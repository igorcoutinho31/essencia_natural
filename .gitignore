# Banco de dados da V2 — gerado localmente por server/seed.js +
# server/migrate-images.js, nunca deve ser commitado (evita conflitos e
# não expõe hash de senha nem sessões). Ver README-V2.md para recriar.
data/essencia.sqlite
data/essencia.sqlite-wal
data/essencia.sqlite-shm
data/essencia.sqlite-journal

# Segredos locais (nunca existe .env commitado neste projeto)
.env
.env.*
!.env.example

node_modules/

# Fotos enviadas pelo /admin a partir de agora (fechamento V2, regra 12) —
# o conjunto atual de fotos do catálogo (uploads/products/*/principal.*)
# já está commitado de propósito, como parte do material inicial do site;
# a partir daqui, uploads/ precisa de armazenamento persistente em produção
# (ver README-V2.md, "Checklist para colocar no ar") e não deve mais crescer
# dentro do repositório git a cada foto nova que uma vendedora envia.
uploads/products/*/*
!uploads/products/*/principal.*
