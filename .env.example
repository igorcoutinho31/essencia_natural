# Variáveis de ambiente da Essência Natural.
#
# NA CLOUDFLARE (produção): as variáveis comuns ficam em `wrangler.toml`
# ([vars]) e os segredos são gravados com `npx wrangler secret put NOME`.
# Para o `wrangler dev` local, copie os segredos para um arquivo `.dev.vars`
# (fora do git). Ver docs/CLOUDFLARE.md.
#
# NO NODE LOCAL (`npm run dev`): o servidor lê process.env.
# Nenhum segredo de verdade vive neste arquivo de exemplo.

# Endereço oficial do site (canonical, Open Graph, sitemap). O domínio sem
# "www" redireciona para este.
SITE_URL=https://www.lojaessencianatural.com.br

# Node local: porta e pasta do banco/fotos. Em branco = .local/ no projeto.
PORT=3000
STORAGE_DIR=

# Node local: defina 1 SOMENTE atrás de um proxy reverso confiável que
# termina o HTTPS (ex.: Nginx). Faz o cookie do /admin ganhar
# "Secure" e o limite de tentativas de login usar o IP real. Na Cloudflare
# não se usa (o Worker já sabe o IP e o protocolo).
TRUST_PROXY=0

# API oficial da OliSek (ver docs/OLISEK-INTEGRATION.md). Em branco, o site
# nunca chama a OliSek e a importação manual continua funcionando.
# Na Cloudflare, LOGIN e PASSWORD são segredos (`wrangler secret put`).
OLISEK_API_URL=https://olisek.com.br/api/v1
OLISEK_LOGIN=
OLISEK_PASSWORD=
# "1" = sincroniza o estoque dos vínculos confirmados a cada 30 minutos
# (cron do Worker — só na Cloudflare).
OLISEK_AUTO_SYNC=0

# Não existe "segredo de sessão": a sessão do /admin é um ID aleatório de
# 256 bits guardado na tabela `sessions`, não um token assinado. Ver
# src/auth.js.
