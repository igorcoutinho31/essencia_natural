# Variáveis de ambiente da Essência Natural V2 — copie este arquivo para
# `.env` (nunca commitado, ver .gitignore) e preencha os valores reais.
# Nenhum segredo de verdade vive neste arquivo de exemplo.
#
# Este servidor lê `process.env.*` diretamente (não há pacote `dotenv`
# instalado — o ambiente onde o projeto foi criado bloqueia `npm install`,
# ver README-V2.md). Em produção, defina essas variáveis no painel do
# provedor (Railway/Render/etc.), não em um arquivo `.env` no servidor.

# Porta em que o servidor Node escuta. A maioria dos provedores (Railway,
# Render) já injeta a variável PORT sozinha — normalmente não precisa mexer.
PORT=3000

# Pasta onde o site guarda o banco (essencia.sqlite) e as fotos enviadas
# pelo /admin (uploads/). Em branco = como sempre foi localmente:
# data/essencia.sqlite e uploads/ dentro do projeto. Em produção, aponte
# para onde o volume (disco persistente) da hospedagem está montado — no
# Railway, o mesmo "Mount path" configurado no volume, ex.: /data. Sem isso,
# todo deploy novo apaga produtos, preços, fotos e a conta do admin.
# Ver server/paths.js e README-V2.md ("Publicar no Railway").
STORAGE_DIR=

# Defina como 1 SOMENTE se o servidor Node estiver atrás de um proxy
# reverso confiável que termina o HTTPS antes dele (Railway, Render, Fly,
# um Nginx próprio, etc.) — isso faz o cookie de sessão do /admin ganhar o
# atributo "Secure" corretamente mesmo com req.socket.encrypted=false. Não
# ative isso se o Node aceitar conexões diretamente da internet: o
# cabeçalho X-Forwarded-Proto é fácil de forjar sem um proxy de verdade na
# frente barrando isso.
TRUST_PROXY=1

# Credenciais da API oficial da OliSek — hoje NÃO EXISTEM (a OliSek ainda
# não abriu acesso; ver docs/OLISEK-INTEGRATION.md). Enquanto ficarem em
# branco, o site nunca tenta chamar a OliSek e a integração continua 100%
# manual (importação de relatório colado em /admin). Preencha só quando a
# loja conseguir a chave de verdade — nunca um valor inventado.
OLISEK_API_URL=
OLISEK_API_KEY=

# Não existe uma variável de "segredo de sessão" aqui de propósito: a
# sessão do /admin usa um ID opaco de 256 bits (crypto.randomBytes(32)),
# gerado por login e guardado na tabela `sessions` do próprio banco — não é
# um token assinado (JWT) que dependa de uma chave secreta compartilhada
# para ser validado. Adicionar uma variável desse tipo aqui criaria uma
# configuração que nada no código usa. Ver server/auth.js.
